{
  "plugins": ["typescript", "oxc", "vue"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-explicit-any": "off"
  },
  "ignorePatterns": [
    ".nuxt/**",
    ".output/**",
    "dist/**",
    "node_modules/**",
    ".netlify/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "overrides": [
    {
      "files": [
        "app/components/Orbit/**",
        "app/pages/**",
        "app/layouts/**",
        "app/composables/**",
        "app/plugins/**",
        "app/utils/files.ts",
        "app/utils/persistence.ts",
        "server/**",
        "shared/**"
      ],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
          }
        ]
      }
    }
  ]
}
